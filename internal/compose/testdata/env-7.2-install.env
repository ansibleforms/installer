# AnsibleForms 7.2.0, set up by hand from the ansibleforms/docker repository
LOG_LEVEL=notice
MYSQLDB_ROOT_PASSWORD=Root!Secret!Of!Mine
MYSQLDB_USER=ansibleforms
MYSQLDB_PASSWORD=App!Secret!Of!Mine
MYSQLDB_LOCAL_PORT=127.0.0.1:3306
MYSQLDB_DOCKER_PORT=3306
NODE_ENV=production
WEBAPP_LOCAL_PORT=8443
WEBAPP_DOCKER_PORT=443
HTTPS=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin!Of!Mine
ENCRYPTION_SECRET=Encryption!Secret!Of!Mine!32chr
