# The database of the AnsibleForms this RTE runs the playbooks of
DB_HOST=forms-db.example.com
DB_USER=ansibleforms
DB_PASSWORD=AnsibleForms!123
DB_PORT=3306
# the same as the app's : the RTE stores its token encrypted when it registers itself
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef
# the token the app calls it with
RTE_TOKEN=the-72-rte-token-0123456789
# the address the app reaches it on : its runner is named rte72.example.com
RTE_URL=http://rte72.example.com:8000
RTE_MAX_JOBS=4
HTTPS_PROXY=http://proxy.example.com:3128
